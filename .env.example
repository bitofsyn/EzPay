# EzPay Backend 환경변수 예시 (.env 로 복사해 실제 값 입력)
# 이 파일에는 실제 비밀값을 넣지 말 것. .env 는 .gitignore 로 커밋에서 제외된다.

# ── 소셜 로그인(OAuth) ────────────────────────────────────────────────
# 카카오 (https://developers.kakao.com > 내 애플리케이션)
#  - KAKAO_CLIENT_ID: REST API 키
#  - KAKAO_CLIENT_SECRET: 보안 > Client Secret (사용함으로 설정한 경우에만 필요)
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=

# 네이버 (https://developers.naver.com > 애플리케이션 등록)
#  - NAVER_CLIENT_ID / NAVER_CLIENT_SECRET
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# (선택) 제공자 엔드포인트 오버라이드 — 기본값이 있으므로 보통 설정 불필요
# KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
# KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
# NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
# NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me
