# EzPay Frontend 환경변수 예시 (.env 로 복사해 실제 값 입력)

# 백엔드 API 베이스 URL
VITE_API_BASE_URL=http://localhost:8081
VITE_AI_SERVICE_URL=http://localhost:8000

# ── 소셜 로그인(OAuth) ────────────────────────────────────────────────
# 카카오 REST API 키 (카카오 개발자 콘솔 > 앱 키 > REST API 키)
VITE_KAKAO_CLIENT_ID=your-kakao-rest-api-key
# 네이버 Client ID (네이버 개발자센터 > 애플리케이션 등록)
VITE_NAVER_CLIENT_ID=your-naver-client-id

# (선택) 콜백 redirect-uri 베이스. 미설정 시 접속 origin 을 사용한다.
# 운영 환경에서는 https 도메인으로 지정하고 제공자 콘솔의 Redirect URI 에도 동일하게 등록할 것.
# 최종 redirect-uri 형식: {base}/oauth/callback/{kakao|naver}
# VITE_OAUTH_REDIRECT_BASE_URL=https://app.ezpay.com
